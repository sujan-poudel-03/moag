{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-var-requires": "off",
    "prefer-const": "off",
    "no-useless-escape": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "NewExpression[callee.name=/Adapter$/]",
        "message": "Get engines via getEngine()/getAllEngines() — direct construction bypasses cost accounting."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/**/*.ts"
      ],
      "excludedFiles": [
        "src/server/**/*.ts",
        "src/test/**/*.ts",
        "src/bench/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/server",
                  "**/server/*"
                ],
                "message": "The hosted server (src/server) is not in the VSIX: the shipped bundles (scripts/bundle.js) refuse it as an input, so shipped code must not load it. Move the pure part to src/shared/ and import that."
              }
            ]
          }
        ],
        "no-restricted-modules": [
          "error",
          {
            "patterns": [
              "**/server",
              "**/server/*"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/runner/**/*.ts",
        "src/context/**/*.ts",
        "src/adapters/**/*.ts"
      ],
      "excludedFiles": [
        "src/adapters/copilot-adapter.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "vscode",
                "message": "Engine core must not import vscode directly — use src/core/host.ts (ConfigPort/MoagHost)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/server",
                  "**/server/*"
                ],
                "message": "The hosted server (src/server) is not in the VSIX: the shipped bundles (scripts/bundle.js) refuse it as an input, so shipped code must not load it. Move the pure part to src/shared/ and import that."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/server/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "vscode",
                "message": "Engine core must not import vscode directly — use src/core/host.ts (ConfigPort/MoagHost)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/adapters/**/*.ts",
        "src/test/**/*.ts"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": [
        "src/webview/**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "prefer-const": "off"
      }
    }
  ],
  "ignorePatterns": [
    "out/",
    "node_modules/",
    "**/*.d.ts"
  ]
}
